<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- Eigene Lizenz -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.DoorbellIntercom.SettingsCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.DoorbellIntercom.SettingsSection" />

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textAppearance="?attr/textAppearanceCaption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="@string/about_license" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Fremde Komponenten -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.DoorbellIntercom.SettingsCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/about_third_party_title"
                android:textAppearance="@style/TextAppearance.DoorbellIntercom.SettingsSection" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="@string/about_reolink_aio" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_mit_license_text"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autoLink="web"
                android:text="@string/about_feather_icons" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bibliotheken -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.DoorbellIntercom.SettingsCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/about_libraries_title"
                android:textAppearance="@style/TextAppearance.DoorbellIntercom.SettingsSection" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="@string/about_libraries" />

            <!-- Je Build-Variante (play/free) in src/<variante>/res/values definiert. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autoLink="web"
                android:text="@string/about_libraries_variant" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
