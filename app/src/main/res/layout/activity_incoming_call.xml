<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/video_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/videoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/incoming_call_title"
        android:textColor="@color/on_video"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mikrofon-Status mittig über den Buttons bzw. dem Tür-Slider; der Schatten hält den
         Text auch lesbar, wenn er über hellem Videobild liegt. -->
    <TextView
        android:id="@+id/talkStatusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:shadowColor="@color/on_video_shadow"
        android:shadowRadius="4"
        android:textColor="@color/on_video"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/doorSlider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Erscheint erst nach Tippen auf "Tür öffnen" bzw. "Öffnen & Ende" (siehe SlideToConfirmView). -->
    <de.kleinabersmart.doorbellintercom.SlideToConfirmView
        android:id="@+id/doorSlider"
        style="@style/Widget.DoorbellIntercom.DoorSlider"
        app:layout_constraintBottom_toTopOf="@id/bottomArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Vor dem Annehmen ist nur buttonBar sichtbar, danach nur callControls.
         Video, Button-Größe und -Position wie im Hauptbildschirm (activity_main).
         Drei Spalten à 104dp passen ab 336dp Breite. -->
    <FrameLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/buttonBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="24dp">

            <LinearLayout style="@style/Widget.DoorbellIntercom.ButtonColumn">

                <ImageButton
                    android:id="@+id/btnDecline"
                    style="@style/Widget.DoorbellIntercom.IconButton"
                    android:background="@drawable/bg_btn_hangup"
                    android:contentDescription="@string/btn_decline"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    style="@style/Widget.DoorbellIntercom.ButtonLabel"
                    android:text="@string/btn_decline" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.DoorbellIntercom.ButtonColumn">

                <ImageButton
                    android:id="@+id/btnAccept"
                    style="@style/Widget.DoorbellIntercom.IconButton"
                    android:background="@drawable/bg_btn_accept"
                    android:contentDescription="@string/btn_accept"
                    android:src="@drawable/ic_call" />

                <TextView
                    style="@style/Widget.DoorbellIntercom.ButtonLabel"
                    android:text="@string/btn_accept" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.DoorbellIntercom.ButtonColumn">

                <ImageButton
                    android:id="@+id/btnDoorOpenAndHangUp"
                    style="@style/Widget.DoorbellIntercom.IconButton"
                    android:background="@null"
                    android:contentDescription="@string/btn_door_open_and_hang_up"
                    android:padding="0dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_door_hangup" />

                <TextView
                    style="@style/Widget.DoorbellIntercom.ButtonLabel"
                    android:text="@string/label_door_open_and_hang_up" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/callControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="24dp"
            android:visibility="gone">

            <LinearLayout style="@style/Widget.DoorbellIntercom.ButtonColumn">

                <ImageButton
                    android:id="@+id/btnTalk"
                    style="@style/Widget.DoorbellIntercom.IconButton"
                    android:background="@drawable/bg_btn_mic_off"
                    android:contentDescription="@string/btn_talk_start"
                    android:src="@drawable/ic_mic_off" />

                <TextView
                    style="@style/Widget.DoorbellIntercom.ButtonLabel"
                    android:text="@string/label_talk" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.DoorbellIntercom.ButtonColumn">

                <ImageButton
                    android:id="@+id/btnDoorOpen"
                    style="@style/Widget.DoorbellIntercom.IconButton"
                    android:background="@drawable/bg_btn_door"
                    android:contentDescription="@string/btn_door_open"
                    android:src="@drawable/ic_door" />

                <TextView
                    style="@style/Widget.DoorbellIntercom.ButtonLabel"
                    android:text="@string/btn_door_open" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.DoorbellIntercom.ButtonColumn">

                <ImageButton
                    android:id="@+id/btnHangUp"
                    style="@style/Widget.DoorbellIntercom.IconButton"
                    android:background="@drawable/bg_btn_hangup"
                    android:contentDescription="@string/btn_hang_up"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    style="@style/Widget.DoorbellIntercom.ButtonLabel"
                    android:text="@string/btn_hang_up" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
